}
QLabel#AiDialogSubtitle { color: #435168; font-size: 14px; font-weight: 500; }
QPushButton#DnaPresetButton {
    min-height: 36px;
    background: #F0F8F4;
    color: #236044;
    border: 1px solid #89C4A4;
