}
QLabel#AiSectionTitle { color: #17223B; font-size: 17px; font-weight: 700; }
QLabel#DnaSummary {
    color: #34445C;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #F0F6F3, stop:1 #F7FAF8);
    border-radius: 7px;
    font-size: 13px;
    font-weight: 500;
}
QLabel#AiFieldLabel { color: #34445C; font-size: 14px; font-weight: 700; }
QTableWidget#DnaIngredientTable QHeaderView::section {
    background: #EEF7F2;
    color: #34445C;
    font-size: 13px;
    font-weight: 700;
}
QFrame#DnaFlavorCard {
    min-height: 164px;
    max-height: 164px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #F7FAF8,stop:1 #ECF8F2);
    border: 1px solid #B9DCCB;
    border-radius: 9px;
}
QLabel#DnaFlavorTitle { color: #123C2D; font-size: 15px; font-weight: 700; }
QLabel#DnaFlavorHint { color: #526176; font-size: 11px; }
QLabel#DnaFlavorSummary {
    color: #047857;
    background: #E8F7EF;
    border: 1px solid #B8DFC9;
    border-radius: 7px;
    padding: 8px 10px;
    font-size: 13px;
    font-weight: 700;
}
/* ---- 饮食记录与分析：多目标识别、趋势与风险预测 ---- */
QWidget#DietAnalyticsPage { background: #FBFCFA; }
QFrame#DietActionBar,
QFrame#DietMetricCard,
QFrame#DietPanelCard,
QFrame#DietInsightCard,
QFrame#DietRecentCard {
    background: #FFFFFF;
    border: 1px solid #D6E2DC;
    border-radius: 10px;
}
QFrame#AdaptiveTargetCard {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #F2FAF6,stop:0.6 #FFFFFF,stop:1 #EFF8FC);
    border: 1px solid #A9D7C1;
    border-radius: 10px;
}
QLabel#AdaptiveTargetIcon { background: #DFF5EA; border: none; border-radius: 21px; }
QLabel#AdaptiveTargetCaption { color: #526176; font-size: 11px; font-weight: 700; }
QLabel#AdaptiveTargetValue { color: #047857; font-size: 19px; font-weight: 800; }
QLabel#AdaptiveTargetBadge {
    color: #64748B; background: #F1F5F4; border: 1px solid #D4DFDA;
    border-radius: 15px; padding: 0 9px; font-size: 11px; font-weight: 700;
}
QLabel#AdaptiveTargetBadge[active="true"] { color: #047857; background: #E7F7EE; border-color: #9ED8B8; }
QLabel#AdaptiveTargetExplanation { color: #24364D; font-size: 11px; font-weight: 600; }
QLabel#AdaptiveHealthSummary { color: #0E7490; font-size: 10px; font-weight: 600; }
QComboBox#AdaptiveWindowCombo,
QComboBox#FoodVisionReference {
    background: #FFFFFF; border: 1px solid #B9D0C4; border-radius: 7px; padding: 0 8px;
}
QPushButton#DietHealthAction {
    color: #047857; background: #F2FAF6; border: 1px solid #8ED2B5;
    border-radius: 8px; font-size: 13px; font-weight: 700;
}
QPushButton#DietHealthAction:hover { background: #E5F5EC; }
QLabel#DietActionHint {
    color: #475569;
    font-family: "__SHANHENG_BODY_FONT__";
    font-size: 13px;
}
QPushButton#DietPrimaryAction,
QPushButton#DietSecondaryAction {
    min-width: 148px;
    padding: 0 14px;
    border-radius: 8px;
    font-family: "__SHANHENG_BODY_FONT__";
    font-size: 13px;
    font-weight: 600;
}
QPushButton#DietPrimaryAction {
    color: #FFFFFF;
    border: 1px solid #059669;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #078F70,stop:1 #10B981);
}
QPushButton#DietPrimaryAction:hover { background: #078F70; }
QPushButton#DietSecondaryAction {
    color: #047857;
    border: 1px solid #8ED2B5;
    background: #F3FAF6;
}
QPushButton#DietSecondaryAction:hover { background: #E7F6ED; }
QLabel#DietMetricIcon {
    background: #F0F9F5;
    border: none;
    border-radius: 19px;
}
QLabel#DietMetricCaption {
    color: #53637A;
    font-family: "__SHANHENG_BODY_FONT__";
    font-size: 12px;
}
QLabel#DietMetricValue {
    color: #14213D;
    font-family: "__SHANHENG_BODY_FONT__";
    font-size: 17px;
    font-weight: 700;
}
QLabel#DietSectionTitle {
    color: #0B1536;
    font-family: "__SHANHENG_TITLE_FONT__";
    font-size: 18px;
    font-weight: 400;
}
QFrame#DietInsightCard { background: #F4FAF7; border-color: #B7DEC9; }
QLabel#DietInsights {
    color: #263B50;
    font-family: "__SHANHENG_BODY_FONT__";
    font-size: 12px;
}
QLabel#DietAnalysisMeta {
    color: #64748B;
    font-family: "__SHANHENG_BODY_FONT__";
    font-size: 10px;
}
QLabel#DietRecentHint {
    color: #64748B;
    font-family: "__SHANHENG_BODY_FONT__";
    font-size: 11px;
    font-weight: 500;
}
QPushButton#DietDeleteConfirm {
    color: #FFFFFF;
    background: #C2413A;
    border: 1px solid #A5322D;
    border-radius: 7px;
    padding: 7px 14px;
    font-weight: 700;
}
QPushButton#DietDeleteConfirm:hover { background: #A93631; }
QCheckBox#DietSkipDeletePrompt {
    color: #475569;
    spacing: 8px;
    font-size: 12px;
    padding-top: 5px;
}
QCheckBox#DietSkipDeletePrompt::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #A8B5AE;
    border-radius: 3px;
    background: #FFFFFF;
}
QCheckBox#DietSkipDeletePrompt::indicator:checked {
    background: #059669;
    border-color: #047857;
}
QTableWidget#DietRecentTable {
    background: #FFFFFF;
    alternate-background-color: #F7FAF8;
    border: none;
    color: #14213D;
    font-family: "__SHANHENG_BODY_FONT__";
    font-size: 12px;
    selection-background-color: #E3F4EB;
    selection-color: #14213D;
}
QTableWidget#DietRecentTable QHeaderView::section {
    background: #F0F7F3;
    color: #3E5066;
    border: none;
    border-bottom: 1px solid #D6E2DC;
    padding: 4px 7px;
    font-size: 12px;
    font-weight: 600;
}

/* -------------------------------------------------------------------------
   V7 补充视觉稿：冰箱库存、食材拍照录入与餐食拍照识别
   ------------------------------------------------------------------------- */
QWidget#FridgePage {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #FCFFFD, stop:0.58 #FFFFFF, stop:1 #F1FAF6);
}
QFrame#FridgeToolbarPanel {
    background: rgba(255,255,255,226);
    border: 1px solid #D8E5DE;
    border-radius: 11px;
    padding: 8px;
}
QWidget#FridgePage QPushButton#FridgeToolbarButton,
QWidget#FridgePage QPushButton#FridgePhotoAddButton,
QWidget#FridgePage QPushButton#FridgeViewToggleButton {
    min-height: 44px;
    max-height: 44px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #FFFFFF, stop:1 #EEF8F3);
    border: 1px solid #C9D9D1;
    border-radius: 9px;
    color: #17223B;
    font-size: 13px;
    font-weight: 700;
}
QWidget#FridgePage QPushButton#FridgeToolbarButton:hover,
QWidget#FridgePage QPushButton#FridgePhotoAddButton:hover,
QWidget#FridgePage QPushButton#FridgeViewToggleButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #E3F7EC, stop:1 #EAF7FA);
    border-color: #64BE91;
    color: #047857;
}
QWidget#FridgePage QPushButton#FridgeRecipeButton {
    min-height: 46px;
    max-height: 46px;
    color: #FFFFFF;
    border: 1px solid #087F78;
    border-radius: 9px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #078F70, stop:0.56 #10B981, stop:1 #0891B2);
    font-size: 13px;
    font-weight: 700;
}
QWidget#FridgePage QPushButton#FridgeRecipeButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #047857, stop:0.56 #0AA873, stop:1 #087FA0);
}
QWidget#FridgePage QLineEdit#FridgeSearchInput,
QWidget#FridgePage QComboBox#FridgeStatusFilter {
    min-height: 44px;
    max-height: 44px;
    background: rgba(255,255,255,248);
    border: 1px solid #CEDBD5;
    border-radius: 9px;
    padding: 0 12px;
    color: #23334B;
}
QWidget#FridgePage QLineEdit#FridgeSearchInput:focus,
QWidget#FridgePage QComboBox#FridgeStatusFilter:focus {
    border: 2px solid #38A87A;
    padding: 0 11px;
}
QFrame#ExpiryReminder {
    min-height: 52px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #FFF1E3, stop:0.55 #FFF7EE, stop:1 #FFFDF8);
    border: 1px solid #F1C18E;
    border-radius: 11px;
    color: #9A4E25;
}
QFrame#ExpiryReminder QLabel {
    color: #8B4323;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#ExpiryRecipeButton {
    min-height: 36px;
    padding: 0 15px;
    color: #925027;
    background: #FFFFFF;
    border: 1px solid #EAB985;
    border-radius: 8px;
    font-weight: 700;
}
QPushButton#ExpiryRecipeButton:hover { background: #FFF8F0; border-color: #D98E52; }
QFrame[class="FridgeSummaryCell"] {
    border-radius: 11px;
    margin-right: 10px;
}
QFrame[class="FridgeSummaryCell"][tone="green"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #F5FCF8, stop:1 #EAF8F1);
    border-color: #B9E0CC;
}
QFrame[class="FridgeSummaryCell"][tone="blue"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #F5F9FF, stop:1 #EAF3FF);
    border-color: #C5D9F3;
}
QFrame[class="FridgeSummaryCell"][tone="orange"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #FFFAF3, stop:1 #FFF1DF);
    border-color: #EED1A9;
}
QFrame[class="FridgeSummaryCell"][tone="red"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #FFF8F8, stop:1 #FFEDEF);
    border-color: #EEC9CE;
}
QTableWidget#FridgeInventoryTable {
    background: rgba(255,255,255,250);
    alternate-background-color: #F7FBF9;
    border: 1px solid #C9D8D1;
    border-radius: 11px;
    gridline-color: transparent;
    selection-background-color: #E3F4EB;
    selection-color: #17223B;
}
QTableWidget#FridgeInventoryTable QHeaderView::section {
    background: #EFF7F3;
    color: #304158;
    border: none;
    border-bottom: 1px solid #D0DED7;
    padding: 10px 12px;
    font-size: 13px;
    font-weight: 700;
}
QTableWidget#FridgeInventoryTable::item {
    border: none;
    border-bottom: 1px solid #E8EFEB;
    padding: 10px 12px;
}
QWidget#FridgeStatusHost { background: transparent; }
QLabel#FridgeStatusBadge {
    border-radius: 14px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 700;
}
QLabel#FridgeStatusBadge[tone="green"] {
    color: #047857; background: #E7F7EF; border: 1px solid #B7E1CA;
}
QLabel#FridgeStatusBadge[tone="orange"] {
    color: #B75B13; background: #FFF2DF; border: 1px solid #F1CE9F;
}
QLabel#FridgeStatusBadge[tone="red"] {
    color: #C53B45; background: #FFECEF; border: 1px solid #F2C3C9;
}

QDialog#FoodVisionDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #FFFDF8, stop:0.56 #FFFFFF, stop:1 #F0FAF5);
    border: 1px solid #7CB798;
    border-radius: 14px;
    color: #14213D;
}
QLabel#FoodVisionTitle {
    color: #10213B;
    font-family: "__SHANHENG_TITLE_FONT__";
    font-size: 27px;
    font-weight: 500;
}
QLabel#FoodVisionSubtitle { color: #526176; font-size: 13px; font-weight: 500; }
QFrame#FoodVisionImagePanel,
QFrame#FoodVisionResultPanel {
    background: rgba(255,255,255,244);
    border: 1px solid #BFD6CB;
    border-radius: 12px;
}
QFrame#FoodVisionResultPanel { border-color: #69B98E; }
QLabel#FoodVisionPreview {
    color: #526176;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #F4FAF7, stop:1 #EAF7F1);
    border: 1px dashed #79BC9B;
    border-radius: 12px;
    padding: 7px;
    font-size: 13px;
    font-weight: 600;
}
QLabel#FoodVisionStepHint { color: #047857; font-size: 12px; font-weight: 700; }
QFrame#FoodVisionAngleCard { background: #F8FCFA; border: 1px solid #C5DDD1; border-radius: 9px; }
QLabel#FoodVisionAngleTitle { color: #233A4F; font-size: 12px; font-weight: 700; }
QLabel#FoodVisionAnglePreview {
    color: #617083; background: #EFF8F3; border: 1px dashed #72BA96;
    border-radius: 8px; padding: 5px; font-size: 11px; font-weight: 600;
}
QPushButton#FoodVisionAngleButton {
    color: #047857; background: #FFFFFF; border: 1px solid #8CCBAA;
    border-radius: 7px; font-size: 12px; font-weight: 700;
}
QPushButton#FoodVisionAngleButton:hover { background: #EAF7F0; }
QLabel#FoodVisionRangeLabel {
    color: #075E54; background: #E9F8F1; border: 1px solid #B6DFC9;
    border-radius: 7px; padding: 7px 10px; font-size: 13px; font-weight: 700;
}

/* HealthKit / Health Connect mobile-authorized sync bridge */
QDialog#HealthSyncDialog { background: #F9FCFA; color: #14213D; }
QLabel#HealthSyncTitle { color: #10213B; font-size: 27px; font-weight: 700; }
QLabel#HealthSyncSubtitle { color: #526176; font-size: 13px; }
QFrame#HealthPrivacyCard { background: #EDF8FC; border: 1px solid #B9DCE8; border-radius: 9px; }
QLabel#HealthPrivacyText { color: #245166; font-size: 12px; }
QFrame#HealthSourceCard { background: #FFFFFF; border: 1px solid #C9DDD3; border-radius: 11px; }
QLabel#HealthSourceIcon { background: #E7F7EF; border: none; border-radius: 26px; }
QLabel#HealthSourceTitle { color: #17223B; font-size: 16px; font-weight: 700; }
QLabel#HealthSourceSubtitle { color: #526176; font-size: 12px; }
QLabel#HealthSourceDetail { color: #0E7490; font-size: 11px; }
QLabel#HealthStatusBadge { color: #64748B; background: #F1F5F4; border: 1px solid #D3DDD8; border-radius: 15px; font-weight: 700; }
QLabel#HealthStatusBadge[connected="true"] { color: #047857; background: #E7F7EE; border-color: #9DD6B7; }
QPushButton#HealthImportButton {
    color: #FFFFFF; border: 1px solid #078F70; border-radius: 8px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #078F70,stop:1 #10B981);
    font-size: 12px; font-weight: 700;
}
QLabel#HealthFormatHint { color: #64748B; font-size: 11px; }
QLabel#HealthImportResult { color: #334155; background: #F4F7F6; border: 1px solid #D7E1DD; border-radius: 8px; padding: 10px; }
QLabel#HealthImportResult[state="success"] { color: #047857; background: #E8F7EF; border-color: #A6D8BD; }
QLabel#HealthImportResult[state="error"] { color: #B42318; background: #FFF1F0; border-color: #F1B8B3; }
QLabel#FoodVisionSectionTitle { color: #17223B; font-size: 17px; font-weight: 700; }
QLabel#FoodVisionFieldLabel { color: #34445C; font-size: 12px; font-weight: 700; }
QDialog#FoodVisionDialog QLineEdit#AiResultInput,
QDialog#FoodVisionDialog QComboBox#AiResultInput {
    min-height: 36px;
    background: #FFFFFF;
    border: 1px solid #BCD0C6;
    border-radius: 7px;
    padding: 0 10px;
}
QDialog#FoodVisionDialog QLineEdit#AiResultInput:focus,
QDialog#FoodVisionDialog QComboBox#AiResultInput:focus {
    border: 2px solid #0AA873;
    padding: 0 9px;
}
QFrame[class="FoodVisionMetric"] {
    min-height: 66px;
    border: 1px solid #D2E1DA;
    border-radius: 9px;
}
QFrame[class="FoodVisionMetric"][tone="green"] { background: #EDF9F3; border-color: #B9DEC9; }
QFrame[class="FoodVisionMetric"][tone="orange"] { background: #FFF3DF; border-color: #EFCE9A; }
QFrame[class="FoodVisionMetric"][tone="lime"] { background: #F1F9E8; border-color: #C8DDAF; }
QFrame[class="FoodVisionMetric"][tone="blue"] { background: #EBF5FD; border-color: #C1D9EC; }
QFrame[class="FoodVisionMetric"][tone="coral"] { background: #FFF0EA; border-color: #ECC8B9; }
QLabel#FoodVisionMetricLabel { color: #53637A; font-size: 11px; font-weight: 700; }
QFrame[class="FoodVisionMetric"] QDoubleSpinBox#AiNumberInput {
    min-height: 30px;
    max-height: 30px;
    background: transparent;
    border: none;
    padding: 0 4px;
    color: #17223B;
    font-size: 16px;
    font-weight: 700;
}
QFrame[class="FoodVisionMetric"] QLabel#FixedUnitLabel { background: transparent; }
QDialog#FoodVisionDialog QPlainTextEdit#AiNotes {
    background: #F8FBF9;
    border: 1px solid #C8D9D0;
    border-radius: 8px;
}
QPushButton#FoodVisionSaveButton {
    min-height: 46px;
    color: #FFFFFF;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #168BC8, stop:0.48 #0891B2, stop:1 #08A96E);
    border: 1px solid #0A7E8B;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 700;
}
QPushButton#FoodVisionSaveButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #117EB8, stop:0.48 #087F9D, stop:1 #079A65);
}
QPushButton#FoodVisionSaveButton:disabled {
    color: #F5FBF8; background: #B6D3C5; border-color: #B6D3C5;
}
QPushButton#FoodVisionSaveButton:focus { border: 2px solid #164E63; }

QDialog#FridgeVisionDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #F8FFFB, stop:0.56 #FFFFFF, stop:1 #E8F8F1);
    border: 1px solid #68AE88;
    border-radius: 15px;
    color: #14213D;
}
QLabel#FridgeVisionTitle {
    color: #07865D;
    font-family: "__SHANHENG_TITLE_FONT__";
    font-size: 29px;
    font-weight: 700;
}
QLabel#FridgeVisionSubtitle { color: #526176; font-size: 13px; font-weight: 500; }
QFrame#FridgeVisionPhotoCard,
QFrame#FridgeVisionResultCard {
    background: rgba(247,253,250,232);
    border: 1px solid #ACD5C0;
    border-radius: 14px;
}
QFrame#FridgeVisionResultCard { background: rgba(255,255,255,242); }
QLabel#FridgeVisionPreview {
    color: #526176;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #F4FBF7, stop:0.5 #ECF8F2, stop:1 #E3F4EB);
    border: 1px dashed #68B88E;
    border-radius: 14px;
    padding: 8px;
    font-size: 13px;
    font-weight: 600;
}
QLabel#FridgeVisionSectionTitle { color: #17223B; font-size: 18px; font-weight: 700; }
QDialog#FridgeVisionDialog QLabel#AiFieldLabel { color: #34445C; font-size: 13px; font-weight: 700; }
QDialog#FridgeVisionDialog QLineEdit#FridgeVisionInput,
QDialog#FridgeVisionDialog QComboBox#FridgeVisionInput,
QDialog#FridgeVisionDialog QDateEdit#FridgeVisionInput,
QDialog#FridgeVisionDialog QDoubleSpinBox#FridgeVisionWeightSpin {
    min-height: 38px;
    background: #FFFFFF;
    border: 1px solid #B9D0C4;
    border-radius: 8px;
    padding: 0 10px;
    color: #17223B;
    font-size: 13px;
    font-weight: 600;
}
QDialog#FridgeVisionDialog QLineEdit#FridgeVisionInput:focus,
QDialog#FridgeVisionDialog QComboBox#FridgeVisionInput:focus,
QDialog#FridgeVisionDialog QDateEdit#FridgeVisionInput:focus,
QDialog#FridgeVisionDialog QDoubleSpinBox#FridgeVisionWeightSpin:focus {
    border: 2px solid #0AA873;
    padding: 0 9px;
}
QSlider#FridgeVisionWeightSlider::groove:horizontal {
    height: 7px; background: #D5E5DD; border-radius: 3px;
}
QSlider#FridgeVisionWeightSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0891B2, stop:1 #08A96E);
    border-radius: 3px;
}
QSlider#FridgeVisionWeightSlider::handle:horizontal {
    width: 18px; height: 18px; margin: -6px 0;
    background: #FFFFFF; border: 3px solid #08A96E; border-radius: 9px;
}
QLabel#VisionConfidenceBadge {
    color: #047857;
    background: #E4F7ED;
    border: 1px solid #9FD6B9;
    border-radius: 14px;
    padding: 5px 11px;
    font-size: 12px;
    font-weight: 700;
}
QLabel#FridgeVisionDetails {
    color: #38516A;
    background: #F0F7F3;
    border: 1px solid #D5E4DD;
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 12px;
    font-weight: 500;
}
QLabel#FridgeVisionStatus { color: #526176; font-size: 11px; font-weight: 500; }
QDialog#FridgeVisionDialog QPushButton#AiPrimaryButton {
    min-height: 46px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #059669, stop:0.56 #0AA873, stop:1 #16B981);
    border: 1px solid #078A5F;
    border-radius: 9px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: 700;
}
QDialog#FridgeVisionDialog QPushButton#AiPrimaryButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #047857, stop:1 #0AA873);
}
QDialog#FridgeVisionDialog QPushButton#AiPrimaryButton:disabled {
    color: #EEF6F2; background: #B6D2C4; border-color: #B6D2C4;
}

/* V7 补充：识别窗口扩容、等待态与独立食材百科识别。 */
QDialog#FridgeVisionDialog QLineEdit#FridgeVisionInput:disabled,
QDialog#FridgeVisionDialog QComboBox#FridgeVisionInput:disabled,
QDialog#FridgeVisionDialog QDateEdit#FridgeVisionInput:disabled,
QDialog#FridgeVisionDialog QDoubleSpinBox#FridgeVisionWeightSpin:disabled {
    color: #829087;
    background: #F5F7F6;
    border-color: #D5DCDA;
}
QDialog#FridgeVisionDialog QSlider#FridgeVisionWeightSlider:disabled::groove:horizontal,
QDialog#FridgeVisionDialog QSlider#FridgeVisionWeightSlider:disabled::sub-page:horizontal {
    background: #DDE3E0;
}
QDialog#FridgeVisionDialog QSlider#FridgeVisionWeightSlider:disabled::handle:horizontal {
    background: #F4F6F5; border-color: #B8C2BD;
}
QPushButton#FridgeVisionNextButton {
    min-width: 142px;
    color: #047857;
    background: #F2FAF6;
    border: 1px solid #78C3A0;
    border-radius: 9px;
    padding: 0 13px;
    font-size: 13px;
    font-weight: 700;
}
QPushButton#FridgeVisionNextButton:hover {
    background: #E4F5EC; border-color: #08A96E;
}
QPushButton#FridgeVisionNextButton:disabled {
    color: #8AA096; background: #F3F6F4; border-color: #D2DCD7;
}

